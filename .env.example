# Copy this file to .env and replace every placeholder.
# Never commit a real private key or RPC credential.

# --- Required ---

# 64 hex characters (32 bytes), without a 0x prefix, for the hot wallet that
# signs transactions. Use a dedicated, low-balance testnet wallet only.
PRIVATE_KEY=YOUR_PRIVATE_KEY_HEX

# WebSocket RPC endpoint (Arbitrum Sepolia by default).
ALCHEMY_WS_URL=wss://arbitrum-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Contract addresses. Replace the zero placeholders below.
OPTION_MARKET_ADDRESS=0x0000000000000000000000000000000000000000
ORDERBOOK_ADDRESS=0x0000000000000000000000000000000000000000
MARGIN_ACCOUNT_ADDRESS=0x0000000000000000000000000000000000000000

# --- Optional ---

# Expected chain ID. Startup fails on a mismatch. 421614 = Arbitrum Sepolia.
# CHAIN_ID=421614

# MATCH_INTERVAL_MS=500
# LIQUIDATION_INTERVAL_MS=5000
# MAX_MATCHES_PER_TX=50
# GAS_LIMIT=3000000
# MAX_GAS_PRICE_GWEI=5

# First block to replay. 0 or unset uses REPLAY_LOOKBACK_BLOCKS.
# Set this to the Orderbook deployment block for full history; positions opened
# before the replay window are not tracked and may be missed by the liquidator.
# START_BLOCK=0

# Blocks to replay when START_BLOCK is 0. Default 345600 (~24h on Arbitrum).
# REPLAY_LOOKBACK_BLOCKS=345600

# NOTE: liquidation and settlement currently send empty Pyth priceUpdateData and
# rely on cached on-chain prices. Production deployments must use fresh Pyth
# update data from Hermes or another Pyth source; no updater is included here.
